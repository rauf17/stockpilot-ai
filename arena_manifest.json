{
  "arena_version": "0.1",
  "agent_name": "Inventory Sentinel Agent",
  "domain": "Inbox Triage & Inventory Management",
  "description": "Bounded single-agent application for monitoring inventory stock levels, calculating restocking costs, creating draft purchase orders, and handling inbox inquiries with explicit safety boundaries.",
  "endpoint": "/arena/run",
  "health_endpoint": "/health",
  "implementation": "FASTApi + LangChain + Custom Bounded Loop",
  "fault_types": [
    "none",
    "tool_timeout",
    "malformed_tool_output",
    "invalid_agent_decision"
  ],
  "limits": {
    "max_steps": 6,
    "max_tool_retries": 2,
    "run_timeout_seconds": 40,
    "max_response_bytes": 50000
  }
}
